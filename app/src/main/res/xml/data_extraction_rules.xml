<?xml version="1.0" encoding="utf-8"?>
<!-- No automatic backup: the NanoGPT key is encrypted with a Keystore key that never leaves the
     phone, so a restored copy could not be decrypted. Backups go through Exportar → JSON. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
